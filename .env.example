# ===== Configurações do servidor =====
#
# Tudo aqui é lido e conferido UMA vez, no boot, em server/config.ts. Valor com
# formato errado derruba o servidor na hora dizendo qual variável está errada —
# em vez de virar um pagamento que não fecha, semanas depois.

# Porta da API (Render usa 10000; local: 3001)
PORT=3001

# Origens permitidas no CORS (separadas por vírgula). Em produção,
# use o domínio do app: https://seu-app.onrender.com
# (vazio/true = permite todas as origens — só para desenvolvimento)
CORS_ORIGIN=true

# Fuso horário do servidor (afeta horário de funcionamento e relatórios)
TZ=America/Recife

# Diretório de dados (banco SQLite + uploads). Em produção, aponte para o
# disco persistente (ex: Render monta em /data)
DATA_DIR=./data

# ===== Multi-loja =====
# O domínio onde as lojas moram. Com "dominio.com.br" aqui,
# "loja-x.dominio.com.br" resolve a loja de slug "loja-x", e o domínio raiz
# vira a plataforma (painel super-admin).
#
# OBRIGATÓRIO em produção. Sem ele a resolução cai numa heurística que NÃO
# distingue "dominio.com.br" (raiz, 3 rótulos) de "loja.dominio.com"
# (subdomínio, 3 rótulos) — e o domínio raiz seria lido como uma loja chamada
# "dominio". O servidor avisa no boot quando a variável falta.
#
# Em desenvolvimento pode ficar vazio: sem subdomínio, o servidor usa a loja 1,
# e o header "x-shop-slug: outra-loja" permite testar outra. Esse header é
# IGNORADO em produção de propósito — a loja nunca é escolhida pelo cliente.
SHOP_BASE_DOMAIN=

# APP_URL: URL pública do app (produção). Usada no retorno do OAuth e no webhook.
# Ex: https://caldinhodajessica.onrender.com
APP_URL=

# ===== Mercado Pago (OAuth + PIX) =====
# Crie um app em https://www.mercadopago.com.br/developers/panel/app
# Tipo: pagamentos online / Checkout Transparente
# Redirect URL (tem que ser IGUAL a esta):
#   local:    http://localhost:3001/api/mercadopago/callback
#   produção: https://SEU-DOMINIO/api/mercadopago/callback
# Webhook no painel (produção): https://SEU-DOMINIO/api/mercadopago/webhook
# Evento: Pagamentos
# true = só aceita token TEST- (local)
MP_TEST=true
MP_CLIENT_ID=
MP_CLIENT_SECRET=
MP_REDIRECT_URI=http://localhost:3001/api/mercadopago/callback
# Opcional: token da própria conta (pula o OAuth)
# MP_ACCESS_TOKEN=
# Chave pública (cartão no app). Painel → Credenciais → Public Key
# MP_PUBLIC_KEY=
# Segredo do webhook (Painel → Webhooks → "Assinatura secreta"). Sem ele, a
# verificação de assinatura fica DESATIVADA e qualquer requisição é aceita.
MP_WEBHOOK_SECRET=

# ===== Notificações push (Web Push / VAPID) =====
# Opcional. Sem estas variáveis o servidor gera um par na primeira vez e o
# guarda no banco (tabela meta), então ele sobrevive a reinícios. Só defina
# aqui se quiser controlar a chave — e NUNCA troque um par já em uso: a
# inscrição do navegador é assinada com a chave pública que ele recebeu, e
# rotacionar mata em silêncio todos os inscritos.
# Gere com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contato do responsável pelo envio (mailto: ou URL). Vazio = usa APP_URL.
VAPID_SUBJECT=

# ===== Backup automático (Google Drive) =====
# JSON da service account em uma linha. Definir aqui tem prioridade sobre a
# cópia salva no banco — mantenha a chave FORA do arquivo que ela faz backup,
# senão perder o disco significa perder também a credencial do backup.
BACKUP_SERVICE_ACCOUNT=

# ===== Recuperação de acesso =====
# Redefine o PIN da cozinha no próximo boot. Use, entre com o novo PIN e
# REMOVA a variável (senão ela redefine a cada deploy).
# KITCHEN_PIN_RESET=
