# ===== Configurações do servidor =====

# Porta da API (Render usa 10000; local: 3001)
PORT=3001

# Origens permitidas no CORS (separadas por vírgula). Em produção,
# use o domínio do app: https://seu-app.onrender.com
# (vazio/true = permite todas as origens — só para desenvolvimento)
CORS_ORIGIN=true

# Fuso horário do servidor (afeta horário de funcionamento e relatórios)
TZ=America/Recife

# Diretório de dados (banco SQLite + uploads). Em produção, aponte para o
# disco persistente (ex: Render monta em /data)
DATA_DIR=./data

# ===== Legado (não utilizado pelo app) =====
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
